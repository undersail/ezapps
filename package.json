{
  "name": "ezapps",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter web-app dev",
    "dev:webapp": "pnpm --filter web-app dev",
    "dev:funphy": "pnpm --filter funphy dev",
    "dev:grimphy": "pnpm --filter grimphy dev",
    "build:webapp": "pnpm --filter web-app build",
    "build:funphy": "pnpm --filter funphy build",
    "build:grimphy": "pnpm --filter grimphy build",
    "build": "pnpm build:webapp && pnpm build:funphy && pnpm build:grimphy",
    "preview": "pnpm --filter web-app preview",
    "lint": "pnpm --filter web-app lint",
    "type-check": "pnpm -r --parallel type-check"
  }
}
